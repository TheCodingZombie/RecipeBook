<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true" android:background="#FFF9F1"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:id="@+id/viewRoot" android:transitionName="recipeCard" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:id="@+id/viewTitle" android:textSize="26sp" android:textStyle="bold" android:textColor="#234538" android:gravity="center"
    android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <ImageButton android:id="@+id/closeView" android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="Close recipe"
    android:background="?attr/selectableItemBackgroundBorderless" android:minWidth="48dp" android:minHeight="48dp" android:layout_gravity="end|top"
    android:layout_width="48dp" android:layout_height="48dp"/>
  </FrameLayout>
  <ImageView android:id="@+id/viewImage" android:scaleType="centerCrop" android:contentDescription="Main recipe image" android:background="@drawable/recipe_placeholder"
   android:layout_width="match_parent" android:layout_height="220dp"/>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp">
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:paddingEnd="10dp">
    <TextView android:text="Ingredients" android:textSize="20sp" android:textStyle="bold" android:textColor="#315C4B" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/viewIngredients" android:textSize="16sp" android:lineSpacingExtra="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp"/>
   </LinearLayout>
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
    <TextView android:text="Time" android:textSize="20sp" android:textStyle="bold" android:textColor="#315C4B" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/viewTimes" android:textSize="15sp" android:lineSpacingExtra="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp">
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:paddingEnd="10dp">
    <TextView android:text="Steps" android:textSize="20sp" android:textStyle="bold" android:textColor="#315C4B" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/viewSteps" android:textSize="16sp" android:lineSpacingExtra="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp"/>
   </LinearLayout>
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
    <TextView android:text="More photos" android:textSize="20sp" android:textStyle="bold" android:textColor="#315C4B" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:id="@+id/viewMedia" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:paddingBottom="12dp">
   <Button android:id="@+id/shareRecipe" android:text="Share" android:minHeight="52dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/editRecipe" android:text="Edit" android:minHeight="52dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/deleteRecipe" android:text="Delete" android:minHeight="52dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
